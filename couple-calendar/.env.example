# このファイルを .env にコピーして値を入れてください（.env は git に入りません）
#   cp .env.example .env

# ---- Googleカレンダー ---------------------------------------------------------
# 共有カレンダーの「カレンダーID」（設定 → カレンダーの統合 に表示される xxx@group.calendar.google.com）
GOOGLE_CALENDAR_ID=
# サービスアカウントの鍵ファイル（ローカルで Claude Code から使うとき）。Cloud Run では不要
GOOGLE_APPLICATION_CREDENTIALS=~/.config/couple-calendar/sa-key.json
TIMEZONE=Asia/Tokyo

# ---- 夫婦それぞれの設定 ---------------------------------------------------------
# NAME   : 呼び名（予定の担当者として表示されます）
# COLOR  : 予定の色 1=ラベンダー 2=セージ 3=ブドウ 4=フラミンゴ 5=バナナ 6=ミカン 7=ピーコック 8=グラファイト 9=ブルーベリー 10=バジル 11=トマト
# EMAIL  : Googleアカウント（カレンダーアプリから直接入れた予定の担当者を判定するのに使う）
# LINE_USER_ID         : LINEのユーザーID（U から始まる。LINEでボットに「ID」と送ると分かります）
# PERSONAL_CALENDAR_ID : 個人カレンダー（任意。空き時間検索で参照。Gmailアドレスを入れる）
# WORK_CALENDAR_ID     : 仕事のカレンダー（任意。出張・移動の取り込みと空き時間検索で参照。仕事のメールアドレスを入れる）
MEMBER1_NAME=たろう
MEMBER1_COLOR=9
MEMBER1_EMAIL=
MEMBER1_LINE_USER_ID=
MEMBER1_PERSONAL_CALENDAR_ID=
MEMBER1_WORK_CALENDAR_ID=

MEMBER2_NAME=はなこ
MEMBER2_COLOR=4
MEMBER2_EMAIL=
MEMBER2_LINE_USER_ID=
MEMBER2_PERSONAL_CALENDAR_ID=
MEMBER2_WORK_CALENDAR_ID=

# 二人の予定の呼び方と色
BOTH_LABEL=ふたり
BOTH_COLOR=10

# ---- Claude Code から使うとき ---------------------------------------------------
# Claude Code を使う人の名前（「私の予定」をこの人の予定として扱います）
MCP_USER_NAME=たろう

# ---- LINE コンシェルジュ（サーバーで動かすとき） ----------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 考える深さ: low / medium / high（高いほど丁寧で遅く、料金も上がる）
CLAUDE_EFFORT=medium
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# true にすると、未登録の人がボットに話しかけたときにユーザーIDを返信します（最初の設定用）
LINE_SETUP_MODE=false
# グループトークでボットを呼ぶ言葉（カンマ区切り）。メンションでも呼べます
GROUP_TRIGGER_WORDS=コンシェルジュ
